# Defaults to an isolated, persistent demo on this device.
VITE_DATA_MODE=demo

# Optional: enhances matching and skill suggestions. Never prefix with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional server port (defaults to 3000).
PORT=3000

# Shared Firebase mode requires authentication and restrictive rules before public use.
# VITE_DATA_MODE=live
